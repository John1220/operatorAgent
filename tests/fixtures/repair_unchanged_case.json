      "source": "import torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _layernorm_helper(X_ptr, Y_ptr, M, N, stride_xm, stride_xn, stride_ym, stride_yn, eps, BLOCK_N: tl.constexpr):\n    row = tl.program_id(0)\n    x_base = X_ptr + row * stride_xm\n    y_base = Y_ptr + row * stride_ym\n    offs = tl.arange(0, BLOCK_N)\n    mask = offs < N\n    x = tl.load(x_base + offs * stride_xn, mask=mask, other=0.0).to(tl.float32)\n    mean = tl.sum(x, axis=0) / N\n    x_centered = x - mean\n    var = tl.sum(x_centered * x_centered, axis=0) / N\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = x_centered * rstd\n    tl.store(y_base + offs * stride_yn, y.to(tl.float16), mask=mask)\n\ndef kernel(X):\n    M, N = X.shape\n    Y = torch.empty_like(X)\n    BLOCK_N = triton.next_power_of_2(N)\n    grid = (M,)\n    _layernorm_helper[grid](\n        X, Y, M, N,\n        X.stride(0), X.stride(1),\n        Y.stride(0), Y.stride(1),\n        1e-05,\n        BLOCK_N=BLOCK_N\n    )\n    return Y",
