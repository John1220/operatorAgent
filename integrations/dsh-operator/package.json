{
  "name": "dsh-operator-agent",
  "version": "0.2.0",
  "description": "GPU 算子开发判定层 for DeepSeek Harness — 把 operator-agent 的判定/修复/无人值守能力接成 DSH 工具（MCP）",
  "type": "module",
  "private": false,
  "icon": "./icon.svg",
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "examples/v07/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John1220/operatorAgent.git",
    "directory": "integrations/dsh-operator"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "^0.2.1-rc.2",
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "gpu",
    "triton",
    "kernel"
  ],
  "license": "Apache-2.0",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "import": "./index.mjs"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
